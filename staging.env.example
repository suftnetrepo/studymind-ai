# Copy to .env.staging (git-ignored) and fill in. PLACEHOLDERS ONLY - never commit real values.
# Values that docker-compose.staging.yml requires (shell exports or this file via --env-file):
STAGING_POSTGRES_USER=studymind_staging
STAGING_POSTGRES_PASSWORD=<generate: openssl rand -base64 24>
STAGING_TYPESENSE_API_KEY=<generate: openssl rand -hex 24>     # must differ from production's key
PROXY_OPENAI_API_KEY=<development/staging OpenAI key; only the budget proxy receives it>
STAGING_MAX_USD=5

# Read by the API container (.env.staging). Must be staging-specific:
JWT_SECRET_KEY=<generate: openssl rand -hex 32>                # must differ from production's secret
# Leave Stripe, Cloudinary and recovery SMTP unset unless separately approved (test-mode keys / staging folder / sink inbox only).
